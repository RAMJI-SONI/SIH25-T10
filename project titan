<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>BhoomiRakshak AI — Satellite-Based Multi-Hazard Early Warning</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<style>
  :root{
    --void:#060B16;
    --panel:#0D1526;
    --panel-alt:#101C33;
    --panel-hover:#142544;
    --border:#1E2A44;
    --border-soft:#182238;
    --text:#E8EDF7;
    --muted:#8092B3;
    --muted-dim:#5A6A8A;
    --cyan:#34E4EA;
    --flood:#3B9EFF;
    --drought:#E8A33D;
    --landslide:#C0824E;
    --heat:#F2545B;
    --risk-high:#F2545B;
    --risk-med:#E8A33D;
    --risk-low:#34D399;
    --font-display:'Space Grotesk',sans-serif;
    --font-body:'Inter',sans-serif;
    --font-mono:'JetBrains Mono',monospace;
  }
  *{box-sizing:border-box;margin:0;padding:0;}
  html,body{height:100%;}
  body{
    background:var(--void);
    color:var(--text);
    font-family:var(--font-body);
    background-image:
      radial-gradient(ellipse 900px 500px at 15% -10%, rgba(59,158,255,0.08), transparent),
      radial-gradient(ellipse 900px 500px at 90% 10%, rgba(52,228,234,0.06), transparent);
    min-height:100%;
  }
  a{color:inherit;}
  button{font-family:inherit;cursor:pointer;}
  ::selection{background:var(--cyan);color:#04111A;}
  :focus-visible{outline:2px solid var(--cyan);outline-offset:2px;}
  ::-webkit-scrollbar{width:8px;height:8px;}
  ::-webkit-scrollbar-track{background:transparent;}
  ::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}

  /* ---------- Layout ---------- */
  #app{
    display:grid;
    grid-template-columns:264px 1fr 340px;
    grid-template-rows:auto auto 1fr auto;
    grid-template-areas:
      "header header header"
      "sidebar pipeline pipeline"
      "sidebar map aside"
      "footer footer footer";
    min-height:100vh;
    gap:1px;
    background:var(--border-soft);
  }
  header.top{grid-area:header;background:var(--panel);}
  .sidebar{grid-area:sidebar;background:var(--panel);}
  .pipeline-wrap{grid-area:pipeline;background:var(--panel);}
  .map-wrap{grid-area:map;background:var(--panel);position:relative;min-height:420px;}
  aside.right{grid-area:aside;background:var(--panel);display:flex;flex-direction:column;min-height:0;}
  footer.bottom{grid-area:footer;background:var(--panel);}

  /* ---------- Header ---------- */
  header.top{
    display:flex;align-items:center;justify-content:space-between;
    padding:16px 24px;border-bottom:1px solid var(--border-soft);
    flex-wrap:wrap;gap:12px;
  }
  .brand{display:flex;align-items:center;gap:12px;}
  .brand-mark{
    width:38px;height:38px;border-radius:9px;
    background:linear-gradient(145deg, rgba(52,228,234,0.18), rgba(59,158,255,0.05));
    border:1px solid var(--border);
    display:flex;align-items:center;justify-content:center;flex-shrink:0;
  }
  .brand-mark svg{width:20px;height:20px;stroke:var(--cyan);}
  .brand-text h1{
    font-family:var(--font-display);font-size:17px;font-weight:700;
    letter-spacing:0.04em;line-height:1.1;
  }
  .brand-text p{font-size:11.5px;color:var(--muted);margin-top:3px;letter-spacing:0.01em;}
  .brand-text p .sep{color:var(--muted-dim);margin:0 6px;}

  .header-right{display:flex;align-items:center;gap:22px;flex-wrap:wrap;}
  .status-live{display:flex;align-items:center;gap:8px;font-family:var(--font-mono);font-size:12px;color:var(--muted);}
  .dot-live{width:8px;height:8px;border-radius:50%;background:var(--risk-low);box-shadow:0 0 0 0 rgba(52,211,153,0.6);animation:pulseDot 1.8s infinite;}
  @keyframes pulseDot{
    0%{box-shadow:0 0 0 0 rgba(52,211,153,0.55);}
    70%{box-shadow:0 0 0 7px rgba(52,211,153,0);}
    100%{box-shadow:0 0 0 0 rgba(52,211,153,0);}
  }
  .header-stats{display:flex;gap:18px;}
  .hstat{text-align:right;}
  .hstat .n{font-family:var(--font-display);font-size:19px;font-weight:700;}
  .hstat .l{font-size:10px;color:var(--muted);text-transform:uppercase;letter-spacing:0.06em;}
  .hstat.risk .n{color:var(--risk-high);}

  /* ---------- Sidebar ---------- */
  .sidebar{padding:18px 16px;overflow-y:auto;}
  .sidebar-label{font-size:10.5px;text-transform:uppercase;letter-spacing:0.09em;color:var(--muted-dim);margin:4px 4px 10px;font-weight:600;}
  .hazard-card{
    background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:10px;
    padding:12px 12px;margin-bottom:8px;cursor:pointer;transition:border-color .15s, background .15s, transform .1s;
    display:flex;gap:10px;align-items:flex-start;text-align:left;width:100%;color:var(--text);
  }
  .hazard-card:hover{background:var(--panel-hover);}
  .hazard-card.active{border-color:var(--hz-color, var(--cyan));background:var(--panel-hover);}
  .hazard-card:active{transform:scale(0.99);}
  .hazard-icon{
    width:30px;height:30px;border-radius:8px;flex-shrink:0;
    display:flex;align-items:center;justify-content:center;
    background:color-mix(in srgb, var(--hz-color) 16%, transparent);
    border:1px solid color-mix(in srgb, var(--hz-color) 45%, transparent);
  }
  .hazard-icon svg{width:16px;height:16px;stroke:var(--hz-color);}
  .hazard-body{flex:1;min-width:0;}
  .hazard-top{display:flex;justify-content:space-between;align-items:baseline;gap:6px;}
  .hazard-name{font-family:var(--font-display);font-size:13px;font-weight:600;}
  .hazard-count{font-family:var(--font-mono);font-size:11px;color:var(--hz-color);}
  .hazard-desc{font-size:11px;color:var(--muted);margin-top:4px;line-height:1.4;}

  .all-toggle{
    width:100%;text-align:left;background:var(--panel-alt);border:1px solid var(--border-soft);
    border-radius:10px;padding:10px 12px;margin-bottom:14px;font-size:12.5px;color:var(--muted);
    font-family:var(--font-mono);letter-spacing:0.02em;transition:border-color .15s,color .15s;
  }
  .all-toggle.active{border-color:var(--cyan);color:var(--cyan);}

  .sidebar-divider{height:1px;background:var(--border-soft);margin:16px 0;}

  .scan-btn{
    width:100%;background:linear-gradient(135deg,var(--cyan),var(--flood));
    color:#04111A;font-family:var(--font-display);font-weight:700;font-size:13px;
    border:none;border-radius:10px;padding:12px;letter-spacing:0.02em;
    display:flex;align-items:center;justify-content:center;gap:8px;
    transition:opacity .15s, transform .1s;
  }
  .scan-btn:hover{opacity:0.92;}
  .scan-btn:active{transform:scale(0.98);}
  .scan-btn:disabled{opacity:0.55;cursor:not-allowed;}
  .scan-btn svg{width:15px;height:15px;}

  .legend{margin-top:16px;}
  .legend-item{display:flex;align-items:center;gap:8px;font-size:11px;color:var(--muted);margin-bottom:6px;}
  .legend-swatch{width:9px;height:9px;border-radius:50%;flex-shrink:0;}

  /* ---------- Pipeline ---------- */
  .pipeline-wrap{padding:14px 20px;border-bottom:1px solid var(--border-soft);}
  .pipeline-title{font-size:10.5px;text-transform:uppercase;letter-spacing:0.09em;color:var(--muted-dim);margin-bottom:10px;font-weight:600;}
  .pipeline{display:flex;align-items:center;gap:0;}
  .pstage{
    flex:1;background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:9px;
    padding:9px 12px;transition:border-color .3s, background .3s, box-shadow .3s;
  }
  .pstage .pn{font-family:var(--font-mono);font-size:9.5px;color:var(--muted-dim);letter-spacing:0.08em;}
  .pstage .pt{font-family:var(--font-display);font-size:12px;font-weight:600;margin-top:2px;}
  .pstage.active{border-color:var(--cyan);background:rgba(52,228,234,0.08);box-shadow:0 0 18px rgba(52,228,234,0.15);}
  .pstage.active .pt{color:var(--cyan);}
  .pstage.done{border-color:var(--risk-low);}
  .pstage.done .pt{color:var(--risk-low);}
  .parrow{width:22px;text-align:center;color:var(--muted-dim);flex-shrink:0;font-size:14px;}

  /* ---------- Map ---------- */
  .map-wrap{overflow:hidden;}
  #map{width:100%;height:100%;min-height:420px;}
  .map-legend-box{
    position:absolute;bottom:14px;left:14px;z-index:500;
    background:rgba(13,21,38,0.92);border:1px solid var(--border);border-radius:10px;
    padding:10px 12px;font-size:11px;color:var(--muted);backdrop-filter:blur(4px);
  }
  .map-legend-box .lg-row{display:flex;align-items:center;gap:7px;margin-top:5px;}
  .map-legend-box .lg-row:first-child{margin-top:0;}
  .map-pin{
    width:26px;height:26px;border-radius:50%;
    display:flex;align-items:center;justify-content:center;
    font-family:var(--font-mono);font-size:9.5px;font-weight:700;color:#04111A;
    border:2px solid rgba(255,255,255,0.85);box-shadow:0 2px 8px rgba(0,0,0,0.5);
  }
  .map-pin.pulse-high{animation:pinPulse 1.6s infinite;}
  @keyframes pinPulse{
    0%{box-shadow:0 0 0 0 rgba(242,84,91,0.55), 0 2px 8px rgba(0,0,0,0.5);}
    70%{box-shadow:0 0 0 10px rgba(242,84,91,0), 0 2px 8px rgba(0,0,0,0.5);}
    100%{box-shadow:0 0 0 0 rgba(242,84,91,0), 0 2px 8px rgba(0,0,0,0.5);}
  }
  .leaflet-popup-content-wrapper{background:var(--panel-alt);color:var(--text);border-radius:10px;border:1px solid var(--border);}
  .leaflet-popup-tip{background:var(--panel-alt);}
  .leaflet-popup-content{font-family:var(--font-body);font-size:12.5px;margin:11px 13px;}
  .popup-title{font-family:var(--font-display);font-weight:700;font-size:13px;margin-bottom:3px;}
  .popup-risk{font-family:var(--font-mono);font-size:12px;margin-top:4px;}

  /* ---------- Right Aside ---------- */
  aside.right{overflow:hidden;}
  .aside-tabs{display:flex;border-bottom:1px solid var(--border-soft);flex-shrink:0;}
  .aside-tab{flex:1;padding:12px;text-align:center;font-size:11.5px;font-weight:600;letter-spacing:0.03em;
    color:var(--muted);background:transparent;border:none;border-bottom:2px solid transparent;text-transform:uppercase;}
  .aside-tab.active{color:var(--cyan);border-bottom-color:var(--cyan);}
  .aside-panel{flex:1;overflow-y:auto;padding:14px 16px;min-height:0;}
  .aside-panel.hidden{display:none;}

  .alert-item{
    display:flex;gap:10px;padding:10px 10px;border-radius:9px;margin-bottom:7px;
    background:var(--panel-alt);border-left:3px solid var(--hz-color,var(--muted));
    cursor:pointer;transition:background .15s;animation:alertIn .35s ease;
  }
  @keyframes alertIn{from{opacity:0;transform:translateY(-6px);}to{opacity:1;transform:translateY(0);}}
  .alert-item:hover{background:var(--panel-hover);}
  .alert-item .a-icon{width:24px;height:24px;border-radius:6px;background:color-mix(in srgb, var(--hz-color) 18%, transparent);display:flex;align-items:center;justify-content:center;flex-shrink:0;}
  .alert-item .a-icon svg{width:13px;height:13px;stroke:var(--hz-color);}
  .alert-item .a-body{flex:1;min-width:0;}
  .alert-item .a-msg{font-size:12px;line-height:1.35;}
  .alert-item .a-msg b{font-weight:600;}
  .alert-item .a-meta{display:flex;justify-content:space-between;margin-top:4px;font-family:var(--font-mono);font-size:10px;color:var(--muted-dim);}
  .badge-sev{font-size:9px;padding:1px 6px;border-radius:20px;font-family:var(--font-mono);letter-spacing:0.03em;}
  .badge-sev.high{background:rgba(242,84,91,0.18);color:var(--risk-high);}
  .badge-sev.med{background:rgba(232,163,61,0.18);color:var(--risk-med);}
  .badge-sev.low{background:rgba(52,211,153,0.18);color:var(--risk-low);}

  .detail-empty{color:var(--muted);font-size:12.5px;padding:20px 4px;}
  .detail-head{display:flex;justify-content:space-between;align-items:flex-start;gap:8px;}
  .detail-name{font-family:var(--font-display);font-size:15px;font-weight:700;}
  .detail-hazard{font-size:11px;color:var(--hz-color);margin-top:3px;font-weight:600;letter-spacing:0.02em;}
  .risk-ring-score{font-family:var(--font-display);font-size:26px;font-weight:700;}
  .risk-bar-track{height:6px;background:var(--panel-alt);border-radius:6px;margin:10px 0 4px;overflow:hidden;border:1px solid var(--border-soft);}
  .risk-bar-fill{height:100%;border-radius:6px;transition:width .5s ease;}
  .risk-bar-label{display:flex;justify-content:space-between;font-family:var(--font-mono);font-size:10px;color:var(--muted-dim);}

  .signal-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:14px 0;}
  .signal-card{background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:8px;padding:9px 10px;}
  .signal-card .sv{font-family:var(--font-mono);font-size:14px;font-weight:600;color:var(--text);}
  .signal-card .sl{font-size:9.5px;color:var(--muted);margin-top:2px;letter-spacing:0.02em;}

  .chart-title{font-size:10.5px;text-transform:uppercase;letter-spacing:0.08em;color:var(--muted-dim);margin:6px 0 8px;font-weight:600;}
  .chart-box{background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:9px;padding:10px;height:140px;}

  /* ---------- Footer ---------- */
  footer.bottom{padding:14px 24px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;}
  .val-badges{display:flex;gap:10px;flex-wrap:wrap;}
  .val-badge{font-family:var(--font-mono);font-size:10.5px;color:var(--muted);background:var(--panel-alt);border:1px solid var(--border-soft);border-radius:20px;padding:4px 11px;}
  .val-badge b{color:var(--cyan);font-weight:600;}
  .footnote{font-size:10.5px;color:var(--muted-dim);}

  /* ---------- Toasts ---------- */
  #toast-stack{position:fixed;bottom:18px;right:18px;z-index:2000;display:flex;flex-direction:column;gap:8px;align-items:flex-end;}
  .toast{
    background:var(--panel-alt);border:1px solid var(--border);border-left:3px solid var(--hz-color,var(--cyan));
    border-radius:9px;padding:11px 14px;max-width:300px;font-size:12px;box-shadow:0 8px 24px rgba(0,0,0,0.4);
    animation:toastIn .3s ease;
  }
  @keyframes toastIn{from{opacity:0;transform:translateX(16px);}to{opacity:1;transform:translateX(0);}}
  .toast .t-title{font-family:var(--font-display);font-weight:700;font-size:12px;margin-bottom:2px;}

  @media (max-width:980px){
    #app{grid-template-columns:1fr;grid-template-rows:auto auto auto auto auto;
      grid-template-areas:"header" "pipeline" "map" "sidebar" "aside" "footer";}
    .sidebar{display:flex;overflow-x:auto;gap:8px;padding:14px;}
    .sidebar-label,.legend,.sidebar-divider{display:none;}
    .hazard-card{min-width:190px;margin-bottom:0;}
    .scan-btn{min-width:160px;}
    .map-wrap{min-height:340px;}
    #map{min-height:340px;}
    aside.right{max-height:520px;}
  }

  @media (prefers-reduced-motion: reduce){
    .dot-live,.map-pin.pulse-high,.alert-item{animation:none;}
    *{transition:none !important;}
  }
</style>
</head>
<body>

<div id="app">

  <header class="top">
    <div class="brand">
      <div class="brand-mark">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2 3 7l9 5 9-5-9-5Z"/><path d="M3 12l9 5 9-5"/><path d="M3 17l9 5 9-5"/>
        </svg>
      </div>
      <div class="brand-text">
        <h1>BHOOMIRAKSHAK AI</h1>
        <p>Earth Observation × AI/ML × GIS <span class="sep">·</span> SIH 2026 <span class="sep">·</span> PS #9</p>
      </div>
    </div>
    <div class="header-right">
      <div class="status-live"><span class="dot-live"></span> <span id="clock">--:--:--</span> IST</div>
      <div class="header-stats">
        <div class="hstat risk"><div class="n" id="stat-index">--</div><div class="l">National Risk Index</div></div>
        <div class="hstat"><div class="n" id="stat-alerts">--</div><div class="l">Active Alerts</div></div>
        <div class="hstat"><div class="n" id="stat-districts">--</div><div class="l">Districts Monitored</div></div>
      </div>
    </div>
  </header>

  <nav class="sidebar" id="sidebar">
    <div class="sidebar-label">Hazard Modules</div>
    <button class="all-toggle active" id="btn-all" data-filter="all">◎ ALL HAZARDS</button>
    <div id="hazard-cards"></div>

    <div class="sidebar-divider"></div>

    <button class="scan-btn" id="scan-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-9-9c2.5 0 4.8 1 6.4 2.6"/><path d="M21 3v6h-6"/></svg>
      Run Satellite Scan
    </button>

    <div class="legend">
      <div class="legend-item"><span class="legend-swatch" style="background:var(--flood)"></span> FloodGuard — SAR change</div>
      <div class="legend-item"><span class="legend-swatch" style="background:var(--drought)"></span> DroughtSense — NDVI/NDWI</div>
      <div class="legend-item"><span class="legend-swatch" style="background:var(--landslide)"></span> LandslideWatch — DEM+rain</div>
      <div class="legend-item"><span class="legend-swatch" style="background:var(--heat)"></span> HeatShield — LST+built-up</div>
    </div>
  </nav>

  <div class="pipeline-wrap">
    <div class="pipeline-title">Pixels to Action — Processing Pipeline</div>
    <div class="pipeline" id="pipeline">
      <div class="pstage" data-stage="0"><div class="pn">01 · GEE</div><div class="pt">Data Ingestion</div></div>
      <div class="parrow">→</div>
      <div class="pstage" data-stage="1"><div class="pn">02 · FEATURES</div><div class="pt">Processing</div></div>
      <div class="parrow">→</div>
      <div class="pstage" data-stage="2"><div class="pn">03 · ML ENGINE</div><div class="pt">Intelligence</div></div>
      <div class="parrow">→</div>
      <div class="pstage" data-stage="3"><div class="pn">04 · DASHBOARD</div><div class="pt">Action</div></div>
    </div>
  </div>

  <div class="map-wrap">
    <div id="map"></div>
    <div class="map-legend-box">
      <div class="lg-row"><span class="legend-swatch" style="background:var(--risk-high)"></span> High risk (≥75)</div>
      <div class="lg-row"><span class="legend-swatch" style="background:var(--risk-med)"></span> Medium (50–74)</div>
      <div class="lg-row"><span class="legend-swatch" style="background:var(--risk-low)"></span> Low (&lt;50)</div>
    </div>
  </div>

  <aside class="right">
    <div class="aside-tabs">
      <button class="aside-tab active" data-tab="alerts">Alerts</button>
      <button class="aside-tab" data-tab="detail">Detail</button>
    </div>
    <div class="aside-panel" id="panel-alerts"></div>
    <div class="aside-panel hidden" id="panel-detail"></div>
  </aside>

  <footer class="bottom">
    <div class="val-badges">
      <div class="val-badge">Precision <b>0.88</b></div>
      <div class="val-badge">Recall <b>0.84</b></div>
      <div class="val-badge">F1 <b>0.86</b></div>
      <div class="val-badge">IoU <b>0.79</b></div>
    </div>
    <div class="footnote">Demo build — hazard scores are simulated for illustration, not live satellite feeds.</div>
  </footer>

</div>

<div id="toast-stack"></div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.0/chart.umd.min.js"></script>
<script>
(function(){
  "use strict";

  /* ---------------- Hazard metadata ---------------- */
  const ICONS = {
    flood: '<path d="M12 2C12 2 5 10.5 5 15a7 7 0 0 0 14 0c0-4.5-7-13-7-13Z"/>',
    drought: '<path d="M12 22v-7"/><path d="M12 15c-4 0-7-3-7-7 4 0 7 1 7 4"/><path d="M12 15c4 0 7-3 7-7-4 0-7 1-7 4"/>',
    landslide: '<path d="M12 3 2 21h20L12 3Z"/><path d="M12 10v4"/><circle cx="12" cy="17" r="0.6" fill="currentColor" stroke="none"/>',
    heat: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2.5M12 19.5V22M4.2 4.2l1.8 1.8M18 18l1.8 1.8M2 12h2.5M19.5 12H22M4.2 19.8 6 18M18 6l1.8-1.8"/>'
  };

  const HAZARDS = {
    flood:     {label:"FloodGuard",     color:"#3B9EFF", desc:"Sentinel-1 SAR change analysis for flood extent.",        metrics:["SAR Change","Rainfall 24h","Water Extent"]},
    drought:   {label:"DroughtSense",   color:"#E8A33D", desc:"NDVI/NDWI anomalies for vegetation & water stress.",       metrics
